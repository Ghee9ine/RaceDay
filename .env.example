# Copy this file to .env (which is gitignored - never commit the real one)
# before running `docker compose up --build`.

# SQL Server's sa password inside the compose network. Must satisfy SQL
# Server's complexity rules (8+ chars, upper+lower+digit or symbol).
SQL_SA_PASSWORD=Your_strong_password123

# Optional: an Azure Storage connection string for banner/profile-picture
# uploads. Leave blank to run without it - uploads will return 503 via
# NotConfiguredBlobStorageService, everything else works normally.
BLOB_STORAGE_CONNECTION_STRING=
