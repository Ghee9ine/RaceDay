@model List<LeaderboardEntryDto>
@{
    ViewData["Title"] = "Leaderboard";
}
<h1 class="rd-heading h3 mb-3">Leaderboard</h1>

@if (Model is null || Model.Count == 0)
{
    <p class="text-muted">No results captured for this category yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table rd-table align-middle">
            <thead><tr><th>Position</th><th>Bib</th><th>Participant</th><th>Finish time</th><th>Status</th></tr></thead>
            <tbody>
            @foreach (var r in Model.OrderBy(r => r.Position ?? int.MaxValue))
            {
                var badge = new StatusBadgeViewModel("Result", r.Status);
                <tr>
                    <td>@(r.Position?.ToString() ?? "-")</td>
                    <td>@(r.BibNumber ?? "-")</td>
                    <td>@r.ParticipantName</td>
                    <td>@(r.FinishTime?.ToString(@"hh\:mm\:ss") ?? "-")</td>
                    <td><partial name="_StatusBadge" model="badge" /></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

<a asp-action="Index" asp-route-eventId="@ViewBag.EventId" class="btn btn-outline-secondary">Back to results</a>
