@{
    var success = TempData["ToastSuccess"] as string;
    var warning = TempData["ToastWarning"] as string;
    var error = TempData["ToastError"] as string;
}
<div class="rd-toast-stack">
    @if (!string.IsNullOrEmpty(success))
    {
        <div class="toast align-items-center text-bg-success border-0 show mb-2" role="status">
            <div class="d-flex"><div class="toast-body">@success</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div>
        </div>
    }
    @if (!string.IsNullOrEmpty(warning))
    {
        <div class="toast align-items-center text-bg-warning border-0 show mb-2" role="status">
            <div class="d-flex"><div class="toast-body">@warning</div>
                <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast"></button></div>
        </div>
    }
    @if (!string.IsNullOrEmpty(error))
    {
        <div class="toast align-items-center text-bg-danger border-0 show mb-2" role="alert">
            <div class="d-flex"><div class="toast-body">@error</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div>
        </div>
    }
</div>
