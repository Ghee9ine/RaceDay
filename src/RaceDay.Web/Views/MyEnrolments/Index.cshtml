@model List<EnrolmentDto>
@{
    ViewData["Title"] = "My Enrolments";
}
<h1 class="rd-heading h3 mb-3">My enrolments</h1>

@if (Model is null || Model.Count == 0)
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-clipboard-x fs-1"></i>
        <p class="mt-2">You haven't enrolled in any events yet.</p>
        <a asp-controller="Events" asp-action="Index" class="btn btn-primary">Browse events</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table rd-table align-middle">
            <thead><tr><th>Event</th><th>Category</th><th>Bib</th><th>Enrolled on</th><th>Status</th><th></th></tr></thead>
            <tbody>
            @foreach (var e in Model)
            {
                var badge = new StatusBadgeViewModel("Enrolment", e.Status);
                <tr>
                    <td><a asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId">@e.EventName</a></td>
                    <td>@e.CategoryName</td>
                    <td>@(e.BibNumber ?? "-")</td>
                    <td>@e.EnrolmentDate.ToString("dd MMM yyyy")</td>
                    <td><partial name="_StatusBadge" model="badge" /></td>
                    <td class="text-end">
                        @if (e.Status != "Cancelled")
                        {
                            <form asp-action="Cancel" asp-route-id="@e.EnrolmentId" method="post"
                                  onsubmit="return confirm('Cancel this enrolment?');" class="d-inline">
                                <button type="submit" class="btn btn-outline-danger btn-sm">Cancel</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
