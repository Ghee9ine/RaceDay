@model CategoryFormViewModel
@{
    ViewData["Title"] = "Edit Category";
}
<h1 class="rd-heading h3 mb-3">Edit category</h1>
<div class="card rd-card p-4">
    <partial name="_ValidationSummary" />
    <form asp-action="Edit" asp-route-id="@Model.CategoryId" method="post">
        <partial name="_CategoryFormFields" model="Model" />
        <button type="submit" class="btn btn-primary mt-3">Save changes</button>
        <a asp-action="Index" asp-route-eventId="@Model.EventId" class="btn btn-outline-secondary mt-3">Cancel</a>
    </form>
</div>
