@model RouteFormViewModel
@{
    ViewData["Title"] = "Route";
}
<h1 class="rd-heading h3 mb-1">Route</h1>
<p class="text-muted mb-3">@ViewBag.CategoryName</p>

<div class="card rd-card p-4">
    <partial name="_ValidationSummary" />
    <form asp-action="Route" method="post">
        <input type="hidden" asp-for="CategoryId" />
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="StartPoint" class="form-label"></label>
                <input asp-for="StartPoint" class="form-control" />
                <span asp-validation-for="StartPoint" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="EndPoint" class="form-label"></label>
                <input asp-for="EndPoint" class="form-control" />
                <span asp-validation-for="EndPoint" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ElevationGainM" class="form-label"></label>
                <input asp-for="ElevationGainM" class="form-control" type="number" />
                <span asp-validation-for="ElevationGainM" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="MapUrl" class="form-label"></label>
                <input asp-for="MapUrl" class="form-control" placeholder="https://..." />
                <span asp-validation-for="MapUrl" class="text-danger small"></span>
            </div>
        </div>
        <button type="submit" class="btn btn-primary mt-3">Save route</button>
        <a asp-action="Index" asp-route-eventId="@ViewBag.EventId" class="btn btn-outline-secondary mt-3">Back to categories</a>
    </form>
</div>
