@model CategoryFormViewModel
<input type="hidden" asp-for="EventId" />
<input type="hidden" asp-for="CategoryId" />

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="DistanceKm" class="form-label"></label>
        <input asp-for="DistanceKm" class="form-control" type="number" step="0.1" />
        <span asp-validation-for="DistanceKm" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="EntryFee" class="form-label"></label>
        <input asp-for="EntryFee" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="EntryFee" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="MaxParticipants" class="form-label"></label>
        <input asp-for="MaxParticipants" class="form-control" type="number" placeholder="Unlimited" />
        <span asp-validation-for="MaxParticipants" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="AgeGroup" class="form-label"></label>
        <select asp-for="AgeGroup" class="form-select" asp-items="@(new SelectList(AgeGroupOptions.All))"></select>
        <span asp-validation-for="AgeGroup" class="text-danger small"></span>
    </div>
</div>
